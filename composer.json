{
    "name": "examples/php-apache",
    "description": "PHP 8.5 application on Apache: Composer in the pipeline, release directories, symlink",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "nesbot/carbon": "^3.8",
        "monolog/monolog": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "Examples\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Examples\\Tests\\": "tests/" }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
